<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- NuGet package metadata -->
    <PackageId>BoringSslStream</PackageId>
    <Version>1.0.4</Version>
    <Authors>Vitaly Yakovlev (optinsoft)</Authors>
    <Owners>optinsoft</Owners>
    <Copyright>Copyright © Vitaly Yakovlev, vitaly@optinsoft.net</Copyright>
    <Description>.NET TLS stream backed by BoringSSL with Chrome-like JA4 fingerprints and native HTTP/2 support.</Description>
    <PackageTags>tls;ssl;boringssl;ja4;http2;fingerprinting</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/optinsoft/BoringSslStream.git</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Native library: .dll for Windows, .so for Linux, .dylib for macOS.
         For local builds it is copied flat to the output directory (DllImport
         probes there; CopyToOutputDirectory items flow transitively through
         ProjectReference). When packed, NuGet places it under
         runtimes/{RID}/native/ so consumers get the right binary automatically. -->
    <None Include="../Native/build/win-x64/proxymap_boringssl.dll"
          Pack="true"
          PackagePath="runtimes/win-x64/native"
          Condition="Exists('../Native/build/win-x64/proxymap_boringssl.dll')" />
    <None Include="../Native/build/linux-x64/libproxymap_boringssl.so"
          Pack="true"
          PackagePath="runtimes/linux-x64/native"
          Condition="Exists('../Native/build/linux-x64/libproxymap_boringssl.so')" />
    <None Include="../Native/build/linux-arm64/libproxymap_boringssl.so"
          Pack="true"
          PackagePath="runtimes/linux-arm64/native"
          Condition="Exists('../Native/build/linux-arm64/libproxymap_boringssl.so')" />
	<None Include="../Native/build/osx-arm64/libproxymap_boringssl.dylib"
          Pack="true"
          PackagePath="runtimes/osx-arm64/native"
          Condition="Exists('../Native/build/osx-arm64/libproxymap_boringssl.dylib')" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

	<PropertyGroup>
		<_HostArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</_HostArch>
		<_NativeRid Condition="$([MSBuild]::IsOSPlatform('Windows')) AND '$(_HostArch)' == 'X64'">win-x64</_NativeRid>
		<_NativeRid Condition="$([MSBuild]::IsOSPlatform('Linux')) AND '$(_HostArch)' == 'X64'">linux-x64</_NativeRid>
		<_NativeRid Condition="$([MSBuild]::IsOSPlatform('Linux')) AND '$(_HostArch)' == 'Arm64'">linux-arm64</_NativeRid>
		<_NativeRid Condition="$([MSBuild]::IsOSPlatform('OSX')) AND '$(_HostArch)' == 'Arm64'">osx-arm64</_NativeRid>
		<_NativeFile Condition="'$(_NativeRid)' == 'win-x64'">proxymap_boringssl.dll</_NativeFile>
		<_NativeFile Condition="$(_NativeRid.StartsWith('linux-'))">libproxymap_boringssl.so</_NativeFile>
		<_NativeFile Condition="$(_NativeRid.StartsWith('osx-'))">libproxymap_boringssl.dylib</_NativeFile>
	</PropertyGroup>

	<ItemGroup Condition="'$(_NativeRid)' != '' AND Exists('../Native/build/$(_NativeRid)/$(_NativeFile)')">
		<None Include="../Native/build/$(_NativeRid)/$(_NativeFile)"
			  Link="$(_NativeFile)"
			  CopyToOutputDirectory="PreserveNewest"
			  Pack="false" />
	</ItemGroup>

	<Target Name="EnsureNativeLibrary" BeforeTargets="Build"
          Condition="!Exists('../Native/build/win-x64/proxymap_boringssl.dll') 
		    AND !Exists('../Native/build/linux-x64/libproxymap_boringssl.so') 
			AND !Exists('../Native/build/linux-arm64/libproxymap_boringssl.so') 
			AND !Exists('../Native/build/osx-arm64/libproxymap_boringssl.dylib')">
    <Warning Text="Native library not found under ../Native/build/&lt;rid&gt;. Run Native/build.ps1 (Windows) or Native/build.sh (Linux/macOS) first." />
  </Target>

</Project>